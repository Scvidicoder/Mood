# Local PostgreSQL
POSTGRES_DB=moodpickup
POSTGRES_USER=moodpickup
POSTGRES_PASSWORD=moodpickup_dev
POSTGRES_PORT=5432

# Local services
ASPNETCORE_ENVIRONMENT=Development
DATABASE_APPLY_MIGRATIONS_ON_STARTUP=true
BACKEND_PORT=8080
FRONTEND_PORT=5173
ALLOWED_ORIGINS=http://localhost:5173
VITE_API_URL=http://localhost:8080/api/v1
VITE_SIGNALR_URL=http://localhost:8080/hubs/notifications
PAYMENT_PROVIDER=Development

# Development-only authentication defaults. Replace outside local development.
JWT_ISSUER=MoodPickup
JWT_AUDIENCE=MoodPickup.Client
JWT_SIGNING_KEY=moodpickup-development-signing-key-change-before-production-2026
OTP_HASH_KEY=moodpickup-development-otp-hash-key-change-before-production-2026
ADMIN_SEED_ENABLED=true
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeThisDev1!
ADMIN_FULL_NAME=Development Administrator

# Alif WebCheckout is opt-in. Never commit real credentials.
# CallbackUrl must be publicly reachable HTTPS for provider callbacks.
ALIF_ENABLED=false
ALIF_ENVIRONMENT=Sandbox
ALIF_USE_SANDBOX=true
ALIF_KEY=
ALIF_PASSWORD=
ALIF_CALLBACK_URL=
ALIF_RETURN_URL=https://app.example.com/payment/result
ALIF_GATE=km
ALIF_SANDBOX_BASE_URL=https://test-web.alif.tj/
ALIF_PRODUCTION_BASE_URL=https://web.alif.tj/
ALIF_API_TIMEOUT_SECONDS=15

# Telegram remains optional in local development.
TELEGRAM_ENABLED=false
TELEGRAM_USE_DEVELOPMENT_SENDER=true
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=mood_pickup_bot
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_PUBLIC_BASE_URL=
TELEGRAM_REGISTER_WEBHOOK_ON_STARTUP=false
